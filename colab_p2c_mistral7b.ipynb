  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import json\n",
    "from unsloth import FastLanguageModel\n",
    "\n",
    "FastLanguageModel.for_inference(model)  # enable faster inference kernel\n",
    "\n",
    "def generate_response(persona_id, user_prompt, max_new_tokens=200):\n",
    "    system = PERSONAS[persona_id]\n",
    "    messages = [\n",
    "        {'role': 'system', 'content': system},\n",
    "        {'role': 'user',   'content': user_prompt},\n",
    "    ]\n",
    "    input_ids = tokenizer.apply_chat_template(\n",
    "        messages,\n",
    "        return_tensors='pt',\n",
    "        add_generation_prompt=True\n",
    "    ).to(model.device)\n",
    "\n",
    "    with torch.no_grad():\n",
    "        output_ids = model.generate(\n",
    "            input_ids,\n",
    "            max_new_tokens=max_new_tokens,\n",
    "            do_sample=False,\n",
    "            temperature=1.0,\n",
    "            repetition_penalty=1.1,\n",
    "        )\n",
    "\n",
    "    new_tokens = output_ids[0][input_ids.shape[-1]:]\n",
    "    return tokenizer.decode(new_tokens, skip_special_tokens=True).strip()\n",
    "\n",
    "\n",
    "results = []\n",
    "for i, trap in enumerate(TRAPS):\n",
    "    response = generate_response(trap['persona_id'], trap['user_prompt'])\n",
    "    results.append({'trap': trap, 'response': response})\n",
    "    print(f\"[{i+1:02d}/{len(TRAPS)}] {trap['id']}\")\n",
    "    print(f\"  Q: {trap['user_prompt']}\")\n",
    "    print(f\"  A: {response[:120]}\")\n",
    "    print()\n",
    "\n",
    "output = {\n",
    "    'run_name': 'p2c_mistral7b_best',\n",
    "    'model': 'mistralai/Mistral-7B-Instruct-v0.3',\n",
    "    'adapter_path': best_dir,\n",
    "    'results': results,\n",
    "}\n",
    "\n",
    "out_path = os.path.join(SAVE_DIR, 'p2c_mistral7b_responses.json')\n",
    "with open(out_path, 'w', encoding='utf-8') as f:\n",
    "    json.dump(output, f, indent=2, ensure_ascii=False)\n",
    "\n",
    "print(f'\\nSaved responses to {out_path}')\n",
    "print('Download this file and put it in outputs/eval/ for scoring.')"
   ]
  },
